{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>PinguApps/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Show SDK upgrades outside the qualified feature band for dashboard approval.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["dotnet-sdk"],
      "matchNewValue": "!/^10\\.0\\.4[0-9]{2}$/",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Show compiler upgrades outside the qualified Roslyn baseline for dashboard approval.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Microsoft.CodeAnalysis.CSharp", "Microsoft.CodeAnalysis.Analyzers"],
      "matchNewValue": "!/^5\\.9\\.[0-9]+$/",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Own-package versions select artifacts built by this repository, not external feed updates.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["PinguApps.BlazorContentContracts", "PinguApps.BlazorContentContracts.Analyzers"],
      "enabled": false
    }
  ]
}
